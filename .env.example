# PostgreSQL
# Desenvolvimento local (docker compose):
DATABASE_URL="postgresql://arthur:arthur_local_dev@localhost:55432/arthur_party?schema=public"
DIRECT_URL="postgresql://arthur:arthur_local_dev@localhost:55432/arthur_party?schema=public"

# Produção no Supabase (Connect → Prisma/ORM):
# - Runtime: prefira o Session Pooler (IPv4, porta 5432) ou o Transaction Pooler (6543).
#   Com Transaction Pooler, acrescente ?pgbouncer=true&connection_limit=1.
# - Migrations: use DIRECT_URL apontando para a conexão direta ou Session Pooler.
# DATABASE_URL="postgresql://postgres.<project-ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# DIRECT_URL="postgresql://postgres.<project-ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require"

# Administração — defina valores próprios e longos antes de publicar
